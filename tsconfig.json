{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "*.ts"
  ],
  "exclude": [
    "test/fixtures",
    "src/viewer"
  ]
}
